{
  "name": "magic-tools-vscode",
  "displayName": "Magic Tools",
  "description": "开发者工具箱: 类型转换 / 编解码 / 加解密 / 值计算 / 格式化 / 生成器 / 站长工具 等 119 个工具, 左侧活动栏一键进入",
  "version": "1.3.0",
  "publisher": "freewu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tools",
    "convert",
    "codec",
    "crypto",
    "base64",
    "hash",
    "calculator",
    "formatter",
    "generator",
    "webmaster",
    "json",
    "regex",
    "chmod",
    "cidr",
    "qrcode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/freewu/magic-tools-vscode.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:magic-tools-view"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magic-tools-sidebar",
          "title": "Magic Tools",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "magic-tools-sidebar": [
        {
          "id": "magic-tools-view",
          "name": "工具箱",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "magic-tools.open",
        "title": "打开工具箱",
        "category": "Magic Tools"
      },
      {
        "command": "magic-tools.reload",
        "title": "重新加载工具面板",
        "category": "Magic Tools"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:host",
    "build:webview": "vite build --config webview/vite.config.mts",
    "build:host": "tsc -p tsconfig.json",
    "build:dev": "vite build --config webview/vite.config.mts --mode development",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "watch:host": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json",
    "clean": "node -e \"for (const p of ['out','dist']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "package": "vsce package --no-dependencies",
    "dev:web": "vite --config webview/vite.config.mts",
    "test": "node scripts/smoke.mjs",
    "preview": "vite preview --config webview/vite.config.mts",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.1.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tauri-apps/api": "^2.12.4",
    "@types/crypto-js": "^4.1.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.12.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/vscode": "^1.75.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/vsce": "^3.0.0",
    "antd": "^5.5.0",
    "base-x": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "bignumber.js": "^9.3.1",
    "color-convert": "^2.0.1",
    "crypto-js": "^4.1.1",
    "deepmerge": "^4.3.1",
    "fast-xml-parser": "^4.5.7",
    "highlight.js": "^11.8.0",
    "html-to-image": "^1.11.13",
    "js-base64": "^3.7.5",
    "js-ini": "^1.6.0",
    "jsbarcode": "^3.12.3",
    "jsdom": "^29.1.1",
    "json5": "^2.2.3",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pele": "^1.6.0",
    "pinyin-pro": "^3.15.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql-formatter": "^12.2.1",
    "svgo": "^4.1.0",
    "toml-patch": "^0.2.3",
    "typescript": "^5.9.3",
    "vditor": "^4.0.0",
    "vite": "^8.3.1",
    "yaml": "^2.3.1"
  }
}
